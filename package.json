{
  "name": "fluent-case-builder",
  "version": "0.6.0",
  "private": false,
  "description": "Universal ANSYS Fluent case builder for DeepSeek Harness: task interview, model recommendations, TUI journal and case-file generation, knowledge-base validation, controlled runs with backups, and maintainer reports.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "data",
    "docs",
    "examples",
    "scripts",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ansys",
    "fluent",
    "tui",
    "cfd",
    "case-builder",
    "interactive-journal",
    "simulation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/REPO.git"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "ingest": "node scripts/ingest-report.mjs"
  }
}
