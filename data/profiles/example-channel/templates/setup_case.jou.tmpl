; ============================================================
; Example: steady laminar flow in a channel.
; This is a synthetic template, not a reproduction of someone else's run.
; 1) replace meshFile with the path to your mesh (.msh);
; 2) add your boundary conditions (see fluent_case_interview);
; 3) add reports/fields if needed (see docs/CASE_SPEC.md).
; Channel: length {{L}} mm, height {{h}} mm, mid-height y = {{y_mid}} m.
; ============================================================

; ====================== mesh ======================
/file/read-case "{{meshFile}}"
/mesh/check

; ====================== models ======================
/define/models/viscous laminar yes
/define/models/solver pressure-based yes

; ====================== solver ======================
/solve/set/p-v-coupling 20
/solve/set/number-of-iterations {{iterations}} q
/solve/set/reporting-interval 100 q

; ====================== initialization ======================
/solve/initialize/hyb-initialization yes

; ====================== residual stopping criteria ======================
/solve/monitors/residual convergence-criteria {{residuals}} {{residuals}} {{residuals}} {{residuals}} q q q

; ====================== save ======================
/file/write-case-data "{{caseFileBase}}" yes
exit
