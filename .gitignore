# Dependencies
node_modules/

# Build artifacts
dist/

# Local configs and secrets
*.local.json
.env
.env.*
.envrc

# Raw colleague reports: only aggregates (learning/aggregate.json,
# learning/backlog.md) reach the repository. The reports and notes themselves stay local.
learning/inbox/*
!learning/inbox/.gitkeep

# Generated reports and results of local runs
reports/
analysis/

# Temporary plugin files (registry, backups, run logs)
.fcb-*
*.log

# Service junk
.tmp*
.DS_Store
Thumbs.db
